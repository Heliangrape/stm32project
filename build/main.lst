 347:Core/Src/main.c ****     RxStdId = RxHeader.StdId;
 348:Core/Src/main.c ****     /* 只处理 0x201~0x204 四个电调反馈帧；idx = 0~3 对应电机 1~4 */
 349:Core/Src/main.c ****     if (RxStdId >= 0x201 && RxStdId <= 0x204)                           
 350:Core/Src/main.c ****       {
 351:Core/Src/main.c ****         int idx = (int)(RxStdId - 0x201);                // 0~3 对应电机 1~4
 352:Core/Src/main.c ****         for (int i = 0; i < 8; i++) RxData[i] = tmp[i];  // 拷贝 8 字节（原始）
 353:Core/Src/main.c ****         RxCount++;                                       // 帧数 +1
 354:Core/Src/main.c ****       
 355:Core/Src/main.c ****       /* ③ 心跳灯：每收到 500 帧就翻转一次绿灯
 356:Core/Src/main.c ****             电调回传频率是 1kHz → 约 2Hz 闪烁（肉眼明显）
 357:Core/Src/main.c ****             作用：不用调试器也能判断接收死活
 358:Core/Src/main.c ****                   绿灯稳定闪烁 = 接收正常 ✅
 359:Core/Src/main.c ****                   绿灯不动     = 接收断了 ❌                        */
 360:Core/Src/main.c ****       if ((RxCount % 2000) == 1)   // 4 个电机共约 4kHz 帧率 → 2000 帧仍约 2Hz
 361:Core/Src/main.c ****       {
 362:Core/Src/main.c ****         /* HAL函数：翻转引脚电平（当前是高就变低，是低就变高） */
 363:Core/Src/main.c ****         HAL_GPIO_TogglePin(LED_G_GPIO_Port, LED_G_Pin);
 364:Core/Src/main.c ****       }
 365:Core/Src/main.c **** 
 366:Core/Src/main.c ****       /* 按电调反馈帧格式拼出物理量：高八位在前，低八位在后 */
 367:Core/Src/main.c ****       /* 每个电机只填自己那一格：idx 0~3 ←→ 电机 1~4 */
 368:Core/Src/main.c ****       RxEcd4[idx]     = (uint16_t)((tmp[0] << 8) | tmp[1]);  // 编码器角度 0~8191
 369:Core/Src/main.c ****       RxSpeed4[idx]   = (int16_t) ((tmp[2] << 8) | tmp[3]);  // 转速 RPM
 370:Core/Src/main.c ****       RxCurrent4[idx] = (int16_t) ((tmp[4] << 8) | tmp[5]);  // 实际电流
 371:Core/Src/main.c ****       RxTemp4[idx]    = tmp[6];                              // 温度
 372:Core/Src/main.c ****       RxCount4[idx]++;                                       // 该电机累计帧数
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//ccQOtiY2.s 			page 8


 373:Core/Src/main.c **** 
 374:Core/Src/main.c ****       /* 1 号电机的值同步留在老变量里（调试习惯 + Rotate_Fake 在用） */
 375:Core/Src/main.c ****       RxEcd     = RxEcd4[0];
 376:Core/Src/main.c ****       RxSpeed   = RxSpeed4[0];
 377:Core/Src/main.c ****       RxCurrent = RxCurrent4[0];
 378:Core/Src/main.c ****       RxTemp    = RxTemp4[0];          
 379:Core/Src/main.c ****                          
 380:Core/Src/main.c ****     }
 381:Core/Src/main.c ****   }
