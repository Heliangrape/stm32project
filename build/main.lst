 153:Core/Src/main.c **** /* ============ CAN1 实现（收发）：M3508 + C620 电调 ============ */
 154:Core/Src/main.c **** 
 155:Core/Src/main.c **** int MOTOR1_CURRENT = 500;      // 1号电机电流：正=正转，负=反转，±16384≈±20A
 156:Core/Src/main.c **** 
 157:Core/Src/main.c **** /* ============ 速度环（内环）参数 ============ */
 158:Core/Src/main.c **** #define SPD_MAX      800       // 转速上限：超过就断电流（保护电机）
 159:Core/Src/main.c **** #define KP_SPD       5        // 比例系数（整数）
 160:Core/Src/main.c **** #define KI_SPD       1         // 积分系数（整数；原 0.5f 在整数运算里会被截断�
 161:Core/Src/main.c **** #define CUR_LIMIT    3000      // 电流限幅（整数，±16384≈±20A，3000≈3.7A）
 162:Core/Src/main.c **** 
 163:Core/Src/main.c **** /*
 164:Core/Src/main.c ****  * CAN1 初始化，整个程序只调用一次
 165:Core/Src/main.c ****  * 波特率 = APB1 / (Prescaler x (1 + TimeSeg1 + TimeSeg2))
 166:Core/Src/main.c ****  *        = 42MHz / (3 x (1 + 11 + 2)) = 42MHz / 42 = 1Mbps
 167:Core/Src/main.c ****  * 注意：APB1 频率由时钟配置决定，换了晶振/时钟树后这里必须重新算
 168:Core/Src/main.c ****  */
 169:Core/Src/main.c **** static void CAN1_Init(void)
 170:Core/Src/main.c **** {
 171:Core/Src/main.c ****   GPIO_InitTypeDef gpio = {0};
 172:Core/Src/main.c **** 
 173:Core/Src/main.c ****   /* HAL宏：使能 CAN1 外设的时钟。STM32 外设默认断电，不开时钟则 CAN1 完全�
 174:Core/Src/main.c ****   __HAL_RCC_CAN1_CLK_ENABLE();                 // 开 CAN1 时钟
 175:Core/Src/main.c **** 
 176:Core/Src/main.c ****   /* ★ 硬复位 CAN 外设，让下面的 HAL_CAN_Init 从干净状态重新配置
 177:Core/Src/main.c **** 
 178:Core/Src/main.c ****      为什么需要：CubeMX 生成代码时给 main() 加了一个 MX_CAN1_Init()，它已经用
 179:Core/Src/main.c ****      Prescaler=16 / TSeg1=1TQ / TSeg2=1TQ（=875kbps）初始化过一次 CAN，并且
 180:Core/Src/main.c ****      把 CAN 拉到总线上处于 Normal 模式。这里如果不复位，会出现两个问题：
 181:Core/Src/main.c ****        ① BTR 可能沿用 875kbps → 电调完全收不到指令
 182:Core/Src/main.c ****        ② 前面若已在总线上出错进入 bus-off，HAL_CAN_Init 等 INAK 会超时（10ms）
 183:Core/Src/main.c ****           → hcan1.State 变成 ERROR → 之后 ConfigFilter / Start 会静默失败
 184:Core/Src/main.c **** 
 185:Core/Src/main.c ****      复位 + 把 State 手动置回 RESET 后，HAL_CAN_Init 会：
 186:Core/Src/main.c ****        - 重新调用 HAL_CAN_MspInit（再开一次时钟，无害）
 187:Core/Src/main.c ****        - 用下面 hcan1.Init 里的 1Mbps 参数重新写 BTR 寄存器         */
 188:Core/Src/main.c ****   __HAL_RCC_CAN1_FORCE_RESET();
 189:Core/Src/main.c ****   __HAL_RCC_CAN1_RELEASE_RESET();
 190:Core/Src/main.c ****   hcan1.State = HAL_CAN_STATE_RESET;
 191:Core/Src/main.c **** 
 192:Core/Src/main.c ****   /* HAL宏：使能 GPIOD 的时钟。PD0/PD1 属于 D 口，不开时钟就配置不了这两个�
 193:Core/Src/main.c ****   __HAL_RCC_GPIOD_CLK_ENABLE();                // 开 GPIOD 时钟（PD0/PD1 在 D 口）
 194:Core/Src/main.c **** 
 195:Core/Src/main.c ****   gpio.Pin       = GPIO_PIN_0 | GPIO_PIN_1;    // PD0=RX, PD1=TX
 196:Core/Src/main.c ****   gpio.Mode      = GPIO_MODE_AF_PP;            // 复用推挽
 197:Core/Src/main.c ****   gpio.Pull      = GPIO_PULLUP;                // 上拉
 198:Core/Src/main.c ****   gpio.Speed     = GPIO_SPEED_FREQ_VERY_HIGH;  // 高速
 199:Core/Src/main.c ****   gpio.Alternate = GPIO_AF9_CAN1;              // 复用功能 = CAN1 (AF9)
 200:Core/Src/main.c ****   /* HAL函数：按 gpio 结构体里的配置初始化 GPIO
 201:Core/Src/main.c ****      作用：把 PD0/PD1 从"普通IO"切换成"CAN1 复用功能"（AF9） */
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc3zNuvX.s 			page 5


 202:Core/Src/main.c ****   HAL_GPIO_Init(GPIOD, &gpio);
 203:Core/Src/main.c **** 
 204:Core/Src/main.c ****   hcan1.Instance           = CAN1;             // CAN1 外设
 205:Core/Src/main.c ****   hcan1.Init.Prescaler     = 3;                // 分频（APB1=42MHz，3x14=42 → 正好 1Mbps）
 206:Core/Src/main.c ****   hcan1.Init.Mode          = CAN_MODE_NORMAL;  // 正常模式
 207:Core/Src/main.c ****   hcan1.Init.SyncJumpWidth = CAN_SJW_1TQ;      // 同步跳转宽度
 208:Core/Src/main.c ****   hcan1.Init.TimeSeg1      = CAN_BS1_11TQ;     // 段1
 209:Core/Src/main.c ****   hcan1.Init.TimeSeg2      = CAN_BS2_2TQ;      // 段2（1+11+2=14 → 3x14=42 → 1Mbps，采样�
 210:Core/Src/main.c ****   hcan1.Init.TimeTriggeredMode    = DISABLE;
 211:Core/Src/main.c ****   hcan1.Init.AutoBusOff           = ENABLE;
 212:Core/Src/main.c ****   hcan1.Init.AutoWakeUp           = DISABLE;
 213:Core/Src/main.c ****   hcan1.Init.AutoRetransmission   = ENABLE;
 214:Core/Src/main.c ****   hcan1.Init.ReceiveFifoLocked    = DISABLE;
 215:Core/Src/main.c ****   hcan1.Init.TransmitFifoPriority = DISABLE;
 216:Core/Src/main.c ****   /* HAL函数：用 hcan1.Init 里的参数初始化 CAN1 控制器
 217:Core/Src/main.c ****      内部动作：算波特率、把分频/时间段/工作模式写进 CAN 寄存器 */
 218:Core/Src/main.c ****   HAL_CAN_Init(&hcan1);
 219:Core/Src/main.c ****   gpio.Pin  = GPIO_PIN_8 | GPIO_PIN_9;
 220:Core/Src/main.c ****   gpio.Mode = GPIO_MODE_ANALOG;
 221:Core/Src/main.c ****   gpio.Pull = GPIO_NOPULL;
 222:Core/Src/main.c ****   HAL_GPIO_Init(GPIOB, &gpio);
 223:Core/Src/main.c ****   
 224:Core/Src/main.c ****   /*
 225:Core/Src/main.c ****    * 过滤器（ID_LIST 列表模式）：只放行 0x201~0x204 四个电调反馈帧
 226:Core/Src/main.c ****    * 注意：16 位列表模式下这 4 个字段都是"ID 存储位"，标准 ID 需左移 5 位
 227:Core/Src/main.c ****    */
 228:Core/Src/main.c ****   CAN_FilterTypeDef filter = {0};
 229:Core/Src/main.c ****   filter.FilterMode           = CAN_FILTERMODE_IDLIST;   // 列表模式：只收列出的 ID
 230:Core/Src/main.c ****   filter.FilterScale          = CAN_FILTERSCALE_16BIT;   // 16 位 → 一组装 4 个 ID
 231:Core/Src/main.c ****   filter.FilterIdHigh         = 0x201 << 5;              // 1号电机
 232:Core/Src/main.c ****   filter.FilterIdLow          = 0x202 << 5;              // 2号电机
 233:Core/Src/main.c ****   filter.FilterMaskIdHigh     = 0x203 << 5;              // 3号电机
 234:Core/Src/main.c ****   filter.FilterMaskIdLow      = 0x204 << 5;              // 4号电机
 235:Core/Src/main.c ****   filter.FilterBank           = 0;                       // CAN1 只能用 0~13
 236:Core/Src/main.c ****   filter.FilterFIFOAssignment = CAN_FILTER_FIFO0;        // 送进 FIFO0
 237:Core/Src/main.c ****   filter.FilterActivation     = ENABLE;
 238:Core/Src/main.c ****   /* HAL函数：把上面的 filter 配置写进硬件过滤器
 239:Core/Src/main.c ****      作用：决定总线上哪些 ID 的帧能被收进来（不匹配的硬件直接丢弃） */
 240:Core/Src/main.c ****   HAL_CAN_ConfigFilter(&hcan1, &filter);
 241:Core/Src/main.c **** 
 242:Core/Src/main.c ****   /* HAL函数：让 CAN 离开"初始化模式"、进入正常工作状态
 243:Core/Src/main.c ****      不调用的话，后面所有发送/接收都会直接失败 */
 244:Core/Src/main.c ****   HAL_CAN_Start(&hcan1);                       // 启动 CAN（不启动发送会失败）
 245:Core/Src/main.c **** 
 246:Core/Src/main.c ****   /* 打开接收中断：FIFO0 收到匹配帧 → 触发 CAN1_RX0 中断 → 调用回调 */
 247:Core/Src/main.c ****   /* HAL函数：打开"FIFO0 收到新消息"这个中断使能
 248:Core/Src/main.c ****      打开后：FIFO0 一有新帧，HAL 就会自动调用接收回调函数 */
 249:Core/Src/main.c ****   HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);
 250:Core/Src/main.c ****   /* HAL函数：设置 CAN1_RX0 中断的优先级（抢占优先级0、子优先级0）
