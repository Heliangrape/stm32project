 392:Core/Src/main.c ****             电调回传频率是 1kHz → 约 2Hz 闪烁（肉眼明显）
 393:Core/Src/main.c ****             作用：不用调试器也能判断接收死活
 394:Core/Src/main.c ****                   绿灯稳定闪烁 = 接收正常 ✅
 395:Core/Src/main.c ****                   绿灯不动     = 接收断了 ❌                        */
 396:Core/Src/main.c ****       if ((RxCount % 2000) == 1)   // 4 个电机共约 4kHz 帧率 → 2000 帧仍约 2Hz
 397:Core/Src/main.c ****       {
 398:Core/Src/main.c ****         /* HAL函数：翻转引脚电平（当前是高就变低，是低就变高） */
 399:Core/Src/main.c ****         HAL_GPIO_TogglePin(LED_G_GPIO_Port, LED_G_Pin);
 400:Core/Src/main.c ****       }
 401:Core/Src/main.c **** 
 402:Core/Src/main.c ****       /* 按电调反馈帧格式拼出物理量：高八位在前，低八位在后 */
 403:Core/Src/main.c ****       /* 每个电机只填自己那一格：idx 0~3 ←→ 电机 1~4 */
 404:Core/Src/main.c ****       RxEcd4[idx]     = (uint16_t)((tmp[0] << 8) | tmp[1]);  // 编码器角度 0~8191
 405:Core/Src/main.c ****       RxSpeed4[idx]   = (int16_t) ((tmp[2] << 8) | tmp[3]);  // 转速 RPM
