 320:Core/Src/main.c **** /* ============ 位置环（外环，只用 P 和 D）============ */
 321:Core/Src/main.c **** #define HALF_TURN_CNT   78656   /* 输出轴转半圈 = 转子 9.6 圈 × 8192 计数
 322:Core/Src/main.c ****                                    （若指"转子半圈"，改成 4096） */
 323:Core/Src/main.c **** #define KP_ANG_SHIFT    4       /* P 系数 = 1/8（数值越大刚度越强） */
 324:Core/Src/main.c **** #define KD_ANG_SHIFT    0       /* D 系数 = 1（数值越大阻尼越弱） */
 325:Core/Src/main.c **** #define SPD_CMD_LIMIT   1500    /* 外层输出的目标转速限幅（RPM） */
 326:Core/Src/main.c **** 
 327:Core/Src/main.c **** volatile int32_t errPos, spdCmd;
 328:Core/Src/main.c **** static uint16_t lastEcd  = 0;   /* 上一帧的单圈角度 */
 329:Core/Src/main.c **** static int32_t  totalCnt = 0;   /* 多圈累计角度（转子计数） */
 330:Core/Src/main.c **** static int32_t  startCnt = 0;   /* 起点：第一次调用时的累计角度 */
 331:Core/Src/main.c **** static uint8_t  started  = 0;   /* 是否已记起点 */
 332:Core/Src/main.c **** 
 333:Core/Src/main.c **** static void Rotate_Fake(int32_t targetAngle){
 334:Core/Src/main.c ****   
 335:Core/Src/main.c ****   
 336:Core/Src/main.c **** 
 337:Core/Src/main.c ****   /* ① 单圈角度 0~8191 累加成"多圈位移"
 338:Core/Src/main.c ****         差值转 int16_t：跨越 0/8191 边界时自动得到 ±小增量，天然处理回绕 */
 339:Core/Src/main.c ****   int32_t dCnt = (int32_t)RxEcd - (int32_t)lastEcd;   /* 本帧增量，范围 -8191 ~ +8191 */
 340:Core/Src/main.c ****   if (dCnt >  4096) dCnt -= 8192;                     /* 正向跨过一圈边界（8191→0） */
 341:Core/Src/main.c ****   if (dCnt < -4096) dCnt += 8192;                     /* 反向跨过一圈边界（0→8191） */
 342:Core/Src/main.c ****   totalCnt += dCnt;
 343:Core/Src/main.c ****   lastEcd   = RxEcd;
 344:Core/Src/main.c **** 
 345:Core/Src/main.c ****   if (!started)                     /* 第一次调用：记下起点 */
 346:Core/Src/main.c ****   {
 347:Core/Src/main.c ****     startCnt = totalCnt;
 348:Core/Src/main.c ****     started  = 1;
 349:Core/Src/main.c ****   }
 350:Core/Src/main.c **** 
 351:Core/Src/main.c ****   /* ② 位置误差（计数）：正 = 还差多少到目标
 352:Core/Src/main.c ****         targetAngle = "从起点还要转多少"（不是转到哪） */
 353:Core/Src/main.c ****   errPos = (startCnt + targetAngle) - totalCnt;
 354:Core/Src/main.c **** 
 355:Core/Src/main.c ****   /* ③ PD：P 项 = 误差右移（÷128）当目标转速；D 项 = 用实测转速当阻尼 */
 356:Core/Src/main.c ****   spdCmd = (errPos >> KP_ANG_SHIFT) - (RxSpeed >> KD_ANG_SHIFT);
 357:Core/Src/main.c **** 
 358:Core/Src/main.c ****   /* ④ 目标转速限幅 */
 359:Core/Src/main.c ****   if (spdCmd > SPD_CMD_LIMIT) spdCmd = SPD_CMD_LIMIT;
 360:Core/Src/main.c ****   if (spdCmd < -SPD_CMD_LIMIT) spdCmd = -SPD_CMD_LIMIT;
 361:Core/Src/main.c **** 
 362:Core/Src/main.c ****   /* ⑤ 交给内层执行（内层把它当成 SPD_TARGET 去追） */
 363:Core/Src/main.c ****   fakeUseSpeed = (int16_t)spdCmd;
 364:Core/Src/main.c ****   SpeedLoop_Fake();
 365:Core/Src/main.c **** }
