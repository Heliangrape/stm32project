 411:Core/Src/main.c ****       RxEcd     = RxEcd4[0];
 412:Core/Src/main.c ****       RxSpeed   = RxSpeed4[0];
 413:Core/Src/main.c ****       RxCurrent = RxCurrent4[0];
 414:Core/Src/main.c ****       RxTemp    = RxTemp4[0];          
 415:Core/Src/main.c ****                          
 416:Core/Src/main.c ****     }
