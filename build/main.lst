 433:Core/Src/main.c **** /*
 434:Core/Src/main.c ****  * 遥控器在线判断
 435:Core/Src/main.c ****  * 返回 1 = 掉线（超过 RC_TIMEOUT_MS 毫秒没收到任何一帧）
 436:Core/Src/main.c ****  * 用途：掉线时必须让电机停住，否则机器人会带着最后一条指令一直跑
 437:Core/Src/main.c ****  */
 438:Core/Src/main.c **** uint8_t RC_is_offline(void)
 439:Core/Src/main.c **** {
 440:Core/Src/main.c ****   if (rc_last_tick == 0)     /* 上电后一帧都没收到过 */
 441:Core/Src/main.c ****   {
 442:Core/Src/main.c ****     return 1;
 443:Core/Src/main.c ****   }
 444:Core/Src/main.c ****   return (HAL_GetTick() - rc_last_tick > RC_TIMEOUT_MS) ? 1 : 0;
 445:Core/Src/main.c **** }
 446:Core/Src/main.c **** 
 447:Core/Src/main.c **** /*
 448:Core/Src/main.c ****  * DMA 版 printf：把格式化好的字符串用 USART1 的 DMA 发到电脑串口助手
 449:Core/Src/main.c ****  * 与标准 printf 的区别：DMA 在后台搬数据，CPU 只做"格式化"这一步
 450:Core/Src/main.c ****  */
 451:Core/Src/main.c **** void usart_printf(const char *fmt, ...)
 452:Core/Src/main.c **** {
 453:Core/Src/main.c ****   static uint8_t tx_buf[PRINT_BUF_SIZE];   /* static：DMA 在后台读它，不能放栈上 */
 454:Core/Src/main.c ****   va_list ap;
 455:Core/Src/main.c ****   int len;
 456:Core/Src/main.c ****   uint32_t t0;
 457:Core/Src/main.c **** 
 458:Core/Src/main.c ****   /*
 459:Core/Src/main.c ****    * 先等上一次 DMA 发完，再往 tx_buf 写新内容
 460:Core/Src/main.c ****    * 不等的话会把"正在发送中的缓冲"覆盖掉 → 输出乱码
 461:Core/Src/main.c ****    * 加超时保护：串口万一异常也不会在这儿死等
 462:Core/Src/main.c ****    */
 463:Core/Src/main.c ****   t0 = HAL_GetTick();
 464:Core/Src/main.c ****   while (huart1.gState != HAL_UART_STATE_READY)
 465:Core/Src/main.c ****   {
 466:Core/Src/main.c ****     if (HAL_GetTick() - t0 > 10)
 467:Core/Src/main.c ****     {
 468:Core/Src/main.c ****       return;
 469:Core/Src/main.c ****     }
 470:Core/Src/main.c ****   }
 471:Core/Src/main.c **** 
 472:Core/Src/main.c ****   /* 变参三步走：va_start 取参数 → vsnprintf 格式化 → va_end 收尾 */
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc1rSlMD.s 			page 13


 473:Core/Src/main.c ****   va_start(ap, fmt);
 474:Core/Src/main.c ****   len = vsnprintf((char *)tx_buf, PRINT_BUF_SIZE, fmt, ap);
 475:Core/Src/main.c ****   va_end(ap);
 476:Core/Src/main.c **** 
 477:Core/Src/main.c ****   if (len <= 0)
 478:Core/Src/main.c ****   {
 479:Core/Src/main.c ****     return;
 480:Core/Src/main.c ****   }
 481:Core/Src/main.c ****   if (len > PRINT_BUF_SIZE - 1)
 482:Core/Src/main.c ****   {
 483:Core/Src/main.c ****     len = PRINT_BUF_SIZE - 1;      /* 内容超出缓冲时截断，防止越界发送 */
 484:Core/Src/main.c ****   }
 485:Core/Src/main.c **** 
 486:Core/Src/main.c ****   /* HAL函数：启动 DMA 发送（非阻塞，立刻返回，数据由 DMA 后台搬走） */
 487:Core/Src/main.c ****   HAL_UART_Transmit_DMA(&huart1, tx_buf, (uint16_t)len);
 488:Core/Src/main.c **** }
 489:Core/Src/main.c **** 
 490:Core/Src/main.c **** /*
 491:Core/Src/main.c ****  * 遥控器接收完成回调（HAL 的弱函数，这里重写它）
 492:Core/Src/main.c ****  * HAL 已经替我们做完：开 IDLE 中断、进 USART3_IRQHandler、算出收到多少字节�
 493:Core/Src/main.c ****  * 关 DMA、重启 DMA —— 我们只拿到"这一趟收了多少字节(Size)"这一个结果
 494:Core/Src/main.c ****  */
 495:Core/Src/main.c **** void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
 496:Core/Src/main.c **** {
 497:Core/Src/main.c ****   if (huart->Instance != USART3)
 498:Core/Src/main.c ****   {
 499:Core/Src/main.c ****     return;
 500:Core/Src/main.c ****   }
 501:Core/Src/main.c **** 
 502:Core/Src/main.c ****   /* 半传输事件：缓冲区只收到一半，不是"一帧结束"，忽略 */
 503:Core/Src/main.c ****   if (huart->RxEventType == HAL_UART_RXEVENT_HT)
 504:Core/Src/main.c ****   {
 505:Core/Src/main.c ****     return;
 506:Core/Src/main.c ****   }
 507:Core/Src/main.c **** 
 508:Core/Src/main.c ****   /* 必须正好是完整一帧（18 字节）才解码；长度不对说明是噪声或中间丢�
 509:Core/Src/main.c ****   if (Size == RC_FRAME_LENGTH)
 510:Core/Src/main.c ****   {
 511:Core/Src/main.c ****     sbus_to_rc(rc_buf, &rc_ctrl);      /* 生数据 → 物理量 */
 512:Core/Src/main.c ****     rc_last_tick = HAL_GetTick();      /* 刷新"遥控器还活着"的时间戳 */
 513:Core/Src/main.c ****   }
 514:Core/Src/main.c **** 
 515:Core/Src/main.c ****   /* 重新武装：再挂一次 DMA 接收，等下一帧（漏了这句就只能收到一帧） *
 516:Core/Src/main.c ****   HAL_UARTEx_ReceiveToIdle_DMA(&huart3, rc_buf, RC_FRAME_LENGTH);
 517:Core/Src/main.c **** 
 518:Core/Src/main.c ****   /* 关掉"半传输中断"：让 HAL 只在"空闲/缓冲区满"时才回调，少进几次中断
 519:Core/Src/main.c ****   __HAL_DMA_DISABLE_IT(huart->hdmarx, DMA_IT_HT);
 520:Core/Src/main.c **** }
 521:Core/Src/main.c **** 
 522:Core/Src/main.c **** /*
 523:Core/Src/main.c ****  * UART 错误回调：HAL 遇到校验错/帧错/溢出时会进这里，
 524:Core/Src/main.c ****  * 而且它**已经自动停止了接收**（UART_EndRxTransfer）—— 所以我们的任务就�
 525:Core/Src/main.c ****  * 清标志 + 把 DMA 接收重新挂上；不做的话，遇到一次错误就永久收不到数�
 526:Core/Src/main.c ****  */
 527:Core/Src/main.c **** void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
 528:Core/Src/main.c **** {
 529:Core/Src/main.c ****   if (huart->Instance != USART3)
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc1rSlMD.s 			page 14


 530:Core/Src/main.c ****   {
 531:Core/Src/main.c ****     return;
 532:Core/Src/main.c ****   }
 533:Core/Src/main.c **** 
 534:Core/Src/main.c ****   __HAL_UART_CLEAR_OREFLAG(huart);          /* 读 SR + DR，清掉错误标志 */
 535:Core/Src/main.c ****   huart->ErrorCode = HAL_UART_ERROR_NONE;   /* 手动清错误码 */
 536:Core/Src/main.c **** 
 537:Core/Src/main.c ****   HAL_UARTEx_ReceiveToIdle_DMA(&huart3, rc_buf, RC_FRAME_LENGTH);   /* 重新武装 */
 538:Core/Src/main.c ****   __HAL_DMA_DISABLE_IT(huart->hdmarx, DMA_IT_HT);
 539:Core/Src/main.c **** }
