 743:Core/Src/main.c **** 
 744:Core/Src/main.c ****     /* ---- BMI088 陀螺仪：读角速度 + 积分成绝对角度 ---- */
 745:Core/Src/main.c ****     {
 746:Core/Src/main.c ****       float g[3];
 747:Core/Src/main.c ****       BMI088_read_gyro(g);
 748:Core/Src/main.c ****       BMI088_gyro[0] = g[0];      /* 存进全局变量，WATCH 里可以直接看 */
 749:Core/Src/main.c ****       BMI088_gyro[1] = g[1];
 750:Core/Src/main.c ****       BMI088_gyro[2] = g[2];
 751:Core/Src/main.c ****       /* 绝对角度 = Z 轴角速度积分（先减掉零漂），dt = 1ms
 752:Core/Src/main.c ****          注意：256 分频下每次读约 200us，主循环实际约 1.2ms；
 753:Core/Src/main.c ****                若转 90° 后 INS_yaw 明显小于 1.57，就把 0.001f 改成 0.0012f */
 754:Core/Src/main.c ****       INS_yaw += (g[2] - gyro_offset[2]) * 0.001f;
 755:Core/Src/main.c ****       /* 归一化到 ±π：每 1ms 的增量极小，两个 if 足够，不需要 while */
 756:Core/Src/main.c ****       if (INS_yaw >  3.14159265f) INS_yaw -= 6.28318531f;
 757:Core/Src/main.c ****       if (INS_yaw < -3.14159265f) INS_yaw += 6.28318531f;
