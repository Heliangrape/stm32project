 413:Core/Src/main.c **** 
 414:Core/Src/main.c ****       /* 1 号电机的值同步留在老变量里（调试习惯 + Rotate_Fake 在用） */
 415:Core/Src/main.c ****       RxEcd     = RxEcd4[0];
 416:Core/Src/main.c ****       RxSpeed   = RxSpeed4[0];
 417:Core/Src/main.c ****       RxCurrent = RxCurrent4[0];
 418:Core/Src/main.c ****       RxTemp    = RxTemp4[0];          
 419:Core/Src/main.c ****                          
 420:Core/Src/main.c ****     }
