 740:Core/Src/main.c ****   while (1)
 741:Core/Src/main.c ****   {
 742:Core/Src/main.c ****          // 速度环：目标 500 RPM，PI 输出电流（带双保护）
 743:Core/Src/main.c ****     /* ---- 精确 1ms 周期（1kHz）----
 744:Core/Src/main.c ****        ★ 不能用 HAL_Delay(1)：HAL 内部 wait = Delay + uwTickFreq = 1 + 1 = 2，
 745:Core/Src/main.c ****          实际会等 1~2ms（平均 1.5ms）→ dt 就不准了 → 积分出的角度只有真实
 746:Core/Src/main.c ****          （车转 360°，INS_yaw 只积到 180°，于是推前正好变成往后）。
 747:Core/Src/main.c ****        这里自己等到 SysTick 前进一格，周期才是真正的 1ms。
 748:Core/Src/main.c ****        注意：循环体若某天超过 1ms，这一格会被跳过，周期就变成 2ms。 */
 749:Core/Src/main.c ****     {
 750:Core/Src/main.c ****       static uint32_t last_tick = 0;
 751:Core/Src/main.c ****       uint32_t now_tick;
 752:Core/Src/main.c ****       do { now_tick = HAL_GetTick(); } while (now_tick == last_tick);
 753:Core/Src/main.c ****       last_tick = now_tick;
 754:Core/Src/main.c ****     }
