 132:Core/Src/main.c **** /*
 133:Core/Src/main.c ****  * CAN1 初始化，整个程序只调用一次
 134:Core/Src/main.c ****  * 波特率 = APB1 / (Prescaler x (1 + TimeSeg1 + TimeSeg2)) = 16MHz / 16 = 1Mbps
 135:Core/Src/main.c ****  */
 136:Core/Src/main.c **** static void CAN1_Init(void)
 137:Core/Src/main.c **** {
 138:Core/Src/main.c ****   GPIO_InitTypeDef gpio = {0};
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****   /* HAL宏：使能 CAN1 外设的时钟。STM32 外设默认断电，不开时钟则 CAN1 完全�
 141:Core/Src/main.c ****   __HAL_RCC_CAN1_CLK_ENABLE();                 // 开 CAN1 时钟
 142:Core/Src/main.c ****   /* HAL宏：使能 GPIOD 的时钟。PD0/PD1 属于 D 口，不开时钟就配置不了这两个�
 143:Core/Src/main.c ****   __HAL_RCC_GPIOD_CLK_ENABLE();                // 开 GPIOD 时钟（PD0/PD1 在 D 口）
 144:Core/Src/main.c **** 
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//ccOTaU1A.s 			page 4


 145:Core/Src/main.c ****   gpio.Pin       = GPIO_PIN_0 | GPIO_PIN_1;    // PD0=RX, PD1=TX
 146:Core/Src/main.c ****   gpio.Mode      = GPIO_MODE_AF_PP;            // 复用推挽
 147:Core/Src/main.c ****   gpio.Pull      = GPIO_PULLUP;                // 上拉
 148:Core/Src/main.c ****   gpio.Speed     = GPIO_SPEED_FREQ_VERY_HIGH;  // 高速
 149:Core/Src/main.c ****   gpio.Alternate = GPIO_AF9_CAN1;              // 复用功能 = CAN1 (AF9)
 150:Core/Src/main.c ****   /* HAL函数：按 gpio 结构体里的配置初始化 GPIO
 151:Core/Src/main.c ****      作用：把 PD0/PD1 从"普通IO"切换成"CAN1 复用功能"（AF9） */
 152:Core/Src/main.c ****   HAL_GPIO_Init(GPIOD, &gpio);
 153:Core/Src/main.c **** 
 154:Core/Src/main.c ****   hcan1.Instance           = CAN1;             // CAN1 外设
 155:Core/Src/main.c ****   hcan1.Init.Prescaler     = 1;                // 分频
 156:Core/Src/main.c ****   hcan1.Init.Mode          = CAN_MODE_NORMAL;  // 正常模式
 157:Core/Src/main.c ****   hcan1.Init.SyncJumpWidth = CAN_SJW_1TQ;      // 同步跳转宽度
 158:Core/Src/main.c ****   hcan1.Init.TimeSeg1      = CAN_BS1_12TQ;     // 段1
 159:Core/Src/main.c ****   hcan1.Init.TimeSeg2      = CAN_BS2_3TQ;      // 段2（1+12+3=16 → 1Mbps）
 160:Core/Src/main.c ****   hcan1.Init.TimeTriggeredMode    = DISABLE;
 161:Core/Src/main.c ****   hcan1.Init.AutoBusOff           = ENABLE;
 162:Core/Src/main.c ****   hcan1.Init.AutoWakeUp           = DISABLE;
 163:Core/Src/main.c ****   hcan1.Init.AutoRetransmission   = ENABLE;
 164:Core/Src/main.c ****   hcan1.Init.ReceiveFifoLocked    = DISABLE;
 165:Core/Src/main.c ****   hcan1.Init.TransmitFifoPriority = DISABLE;
 166:Core/Src/main.c ****   /* HAL函数：用 hcan1.Init 里的参数初始化 CAN1 控制器
 167:Core/Src/main.c ****      内部动作：算波特率、把分频/时间段/工作模式写进 CAN 寄存器 */
 168:Core/Src/main.c ****   HAL_CAN_Init(&hcan1);
 169:Core/Src/main.c **** 
 170:Core/Src/main.c ****   /*
 171:Core/Src/main.c ****    * 过滤器（ID_LIST 列表模式）：只放行 0x201~0x204 四个电调反馈帧
 172:Core/Src/main.c ****    * 注意：16 位列表模式下这 4 个字段都是"ID 存储位"，标准 ID 需左移 5 位
 173:Core/Src/main.c ****    */
 174:Core/Src/main.c ****   CAN_FilterTypeDef filter = {0};
 175:Core/Src/main.c ****   filter.FilterMode           = CAN_FILTERMODE_IDLIST;   // 列表模式：只收列出的 ID
 176:Core/Src/main.c ****   filter.FilterScale          = CAN_FILTERSCALE_16BIT;   // 16 位 → 一组装 4 个 ID
 177:Core/Src/main.c ****   filter.FilterIdHigh         = 0x201 << 5;              // 1号电机
 178:Core/Src/main.c ****   filter.FilterIdLow          = 0x202 << 5;              // 2号电机
 179:Core/Src/main.c ****   filter.FilterMaskIdHigh     = 0x203 << 5;              // 3号电机
 180:Core/Src/main.c ****   filter.FilterMaskIdLow      = 0x204 << 5;              // 4号电机
 181:Core/Src/main.c ****   filter.FilterBank           = 0;                       // CAN1 只能用 0~13
 182:Core/Src/main.c ****   filter.FilterFIFOAssignment = CAN_FILTER_FIFO0;        // 送进 FIFO0
 183:Core/Src/main.c ****   filter.FilterActivation     = ENABLE;
 184:Core/Src/main.c ****   /* HAL函数：把上面的 filter 配置写进硬件过滤器
 185:Core/Src/main.c ****      作用：决定总线上哪些 ID 的帧能被收进来（不匹配的硬件直接丢弃） */
 186:Core/Src/main.c ****   HAL_CAN_ConfigFilter(&hcan1, &filter);
 187:Core/Src/main.c **** 
 188:Core/Src/main.c ****   /* HAL函数：让 CAN 离开"初始化模式"、进入正常工作状态
 189:Core/Src/main.c ****      不调用的话，后面所有发送/接收都会直接失败 */
 190:Core/Src/main.c ****   HAL_CAN_Start(&hcan1);                       // 启动 CAN（不启动发送会失败）
 191:Core/Src/main.c **** 
 192:Core/Src/main.c ****   /* 打开接收中断：FIFO0 收到匹配帧 → 触发 CAN1_RX0 中断 → 调用回调 */
 193:Core/Src/main.c ****   /* HAL函数：打开"FIFO0 收到新消息"这个中断使能
 194:Core/Src/main.c ****      打开后：FIFO0 一有新帧，HAL 就会自动调用接收回调函数 */
 195:Core/Src/main.c ****   HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);
 196:Core/Src/main.c ****   /* HAL函数：设置 CAN1_RX0 中断的优先级（抢占优先级0、子优先级0）
 197:Core/Src/main.c ****      数值越小优先级越高，0 是最高优先级 */
 198:Core/Src/main.c ****   HAL_NVIC_SetPriority(CAN1_RX0_IRQn, 0, 0);   // 优先级
 199:Core/Src/main.c ****   /* HAL函数：在 NVIC（中断控制器）里真正"放行"这个中断
 200:Core/Src/main.c ****      不调用的话，即使 FIFO 有数据，CPU 也不会跳进中断函数 */
 201:Core/Src/main.c ****   HAL_NVIC_EnableIRQ(CAN1_RX0_IRQn);           // 放行中断
