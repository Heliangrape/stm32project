 365:Core/Src/main.c ****       }
 366:Core/Src/main.c **** 
 367:Core/Src/main.c ****       /* 按电调反馈帧格式拼出物理量：高八位在前，低八位在后 */
 368:Core/Src/main.c ****       /* 每个电机只填自己那一格：idx 0~3 ←→ 电机 1~4 */
 369:Core/Src/main.c ****       RxEcd4[idx]     = (uint16_t)((tmp[0] << 8) | tmp[1]);  // 编码器角度 0~8191
 370:Core/Src/main.c ****       RxSpeed4[idx]   = (int16_t) ((tmp[2] << 8) | tmp[3]);  // 转速 RPM
 371:Core/Src/main.c ****       RxCurrent4[idx] = (int16_t) ((tmp[4] << 8) | tmp[5]);  // 实际电流
