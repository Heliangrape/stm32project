 725:Core/Src/main.c ****                (int)(gyro_offset[0] * 100000.0f),
 726:Core/Src/main.c ****                (int)(gyro_offset[1] * 100000.0f),
 727:Core/Src/main.c ****                (int)(gyro_offset[2] * 100000.0f));
