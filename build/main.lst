 281:Core/Src/main.c **** /* ============ 位置环（外环，只用 P 和 D）============ */
 282:Core/Src/main.c **** #define HALF_TURN_CNT   78656   /* 输出轴转半圈 = 转子 9.6 圈 × 8192 计数
 283:Core/Src/main.c ****                                    （若指"转子半圈"，改成 4096） */
 284:Core/Src/main.c **** #define KP_ANG_SHIFT    4       /* P 系数 = 1/8（数值越大刚度越强） */
 285:Core/Src/main.c **** #define KD_ANG_SHIFT    0       /* D 系数 = 1（数值越大阻尼越弱） */
 286:Core/Src/main.c **** #define SPD_CMD_LIMIT   1500    /* 外层输出的目标转速限幅（RPM） */
 287:Core/Src/main.c **** 
 288:Core/Src/main.c **** volatile int32_t errPos, spdCmd;
 289:Core/Src/main.c **** static uint16_t lastEcd  = 0;   /* 上一帧的单圈角度 */
 290:Core/Src/main.c **** static int32_t  totalCnt = 0;   /* 多圈累计角度（转子计数） */
 291:Core/Src/main.c **** static int32_t  startCnt = 0;   /* 起点：第一次调用时的累计角度 */
 292:Core/Src/main.c **** static uint8_t  started  = 0;   /* 是否已记起点 */
 293:Core/Src/main.c **** 
 294:Core/Src/main.c **** static void Rotate_Fake(int32_t targetAngle){
 295:Core/Src/main.c ****   
 296:Core/Src/main.c ****   
 297:Core/Src/main.c **** 
 298:Core/Src/main.c ****   /* ① 单圈角度 0~8191 累加成"多圈位移"
 299:Core/Src/main.c ****         差值转 int16_t：跨越 0/8191 边界时自动得到 ±小增量，天然处理回绕 */
 300:Core/Src/main.c ****   int32_t dCnt = (int32_t)RxEcd - (int32_t)lastEcd;   /* 本帧增量，范围 -8191 ~ +8191 */
 301:Core/Src/main.c ****   if (dCnt >  4096) dCnt -= 8192;                     /* 正向跨过一圈边界（8191→0） */
 302:Core/Src/main.c ****   if (dCnt < -4096) dCnt += 8192;                     /* 反向跨过一圈边界（0→8191） */
 303:Core/Src/main.c ****   totalCnt += dCnt;
 304:Core/Src/main.c ****   lastEcd   = RxEcd;
 305:Core/Src/main.c **** 
 306:Core/Src/main.c ****   if (!started)                     /* 第一次调用：记下起点 */
 307:Core/Src/main.c ****   {
 308:Core/Src/main.c ****     startCnt = totalCnt;
 309:Core/Src/main.c ****     started  = 1;
 310:Core/Src/main.c ****   }
 311:Core/Src/main.c **** 
 312:Core/Src/main.c ****   /* ② 位置误差（计数）：正 = 还差多少到目标
 313:Core/Src/main.c ****         targetAngle = "从起点还要转多少"（不是转到哪） */
 314:Core/Src/main.c ****   errPos = (startCnt + targetAngle) - totalCnt;
 315:Core/Src/main.c **** 
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc1rSlMD.s 			page 7


 316:Core/Src/main.c ****   /* ③ PD：P 项 = 误差右移（÷128）当目标转速；D 项 = 用实测转速当阻尼 */
 317:Core/Src/main.c ****   spdCmd = (errPos >> KP_ANG_SHIFT) - (RxSpeed >> KD_ANG_SHIFT);
 318:Core/Src/main.c **** 
 319:Core/Src/main.c ****   /* ④ 目标转速限幅 */
 320:Core/Src/main.c ****   if (spdCmd > SPD_CMD_LIMIT) spdCmd = SPD_CMD_LIMIT;
 321:Core/Src/main.c ****   if (spdCmd < -SPD_CMD_LIMIT) spdCmd = -SPD_CMD_LIMIT;
 322:Core/Src/main.c **** 
 323:Core/Src/main.c ****   /* ⑤ 交给内层执行（内层把它当成 SPD_TARGET 去追） */
 324:Core/Src/main.c ****   fakeUseSpeed = (int16_t)spdCmd;
 325:Core/Src/main.c ****   SpeedLoop_Fake();
 326:Core/Src/main.c **** }
