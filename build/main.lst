 254:Core/Src/main.c ****                                    （若指"转子半圈"，改成 4096） */
 255:Core/Src/main.c **** #define KP_ANG_SHIFT    4       /* P 系数 = 1/8（数值越大刚度越强） */
 256:Core/Src/main.c **** #define KD_ANG_SHIFT    0       /* D 系数 = 1（数值越大阻尼越弱） */
 257:Core/Src/main.c **** #define SPD_CMD_LIMIT   1500    /* 外层输出的目标转速限幅（RPM） */
