 204:Core/Src/main.c **** /*
 205:Core/Src/main.c ****  * 发送电流指令给 1~4 号电调（CAN ID = 0x200）
 206:Core/Src/main.c ****  * cur1~cur4：电流给定，正=正转，负=反转，±16384 对应 ±20A
 207:Core/Src/main.c ****  */
 208:Core/Src/main.c **** static void CAN_cmd_chassis(int16_t cur1, int16_t cur2, int16_t cur3, int16_t cur4)
 209:Core/Src/main.c **** {
 210:Core/Src/main.c ****   uint32_t TxMailbox;
 211:Core/Src/main.c **** 
 212:Core/Src/main.c ****   TxHeader.StdId = 0x200;         // CAN ID
 213:Core/Src/main.c ****   TxHeader.IDE   = CAN_ID_STD;    // 标准帧
 214:Core/Src/main.c ****   TxHeader.RTR   = CAN_RTR_DATA;  // 数据帧
 215:Core/Src/main.c ****   TxHeader.DLC   = 8;             // 8 字节
 216:Core/Src/main.c **** 
 217:Core/Src/main.c ****   TxData[0] = cur1 >> 8;   TxData[1] = cur1 & 0xFF;   // 电机1
 218:Core/Src/main.c ****   TxData[2] = cur2 >> 8;   TxData[3] = cur2 & 0xFF;   // 电机2
 219:Core/Src/main.c ****   TxData[4] = cur3 >> 8;   TxData[5] = cur3 & 0xFF;   // 电机3
 220:Core/Src/main.c ****   TxData[6] = cur4 >> 8;   TxData[7] = cur4 & 0xFF;   // 电机4
 221:Core/Src/main.c **** 
 222:Core/Src/main.c ****   /* HAL函数：把这一帧放进发送邮箱并请求发送
 223:Core/Src/main.c ****      参数依次：CAN句柄、帧头（含ID/长度）、8字节数据、回填"用了哪个邮�
 224:Core/Src/main.c ****      注意：返回 HAL_OK 只表示"投递成功"，不代表电调收到了（要等对方回 AC
 225:Core/Src/main.c ****   HAL_CAN_AddTxMessage(&hcan1, &TxHeader, TxData, &TxMailbox);
 226:Core/Src/main.c **** }
 227:Core/Src/main.c **** 
 228:Core/Src/main.c **** /*
 229:Core/Src/main.c ****  * 速度环（内环）：让电机稳定在 SPD_TARGET 转速
 230:Core/Src/main.c ****  * 输出 = PI(目标转速 - 实际转速) → 电流
 231:Core/Src/main.c ****  * 两道保护：① 反馈超时（50ms 收不到新帧）→ 断输出
 232:Core/Src/main.c ****  *           ② 转速超过 SPD_MAX            → 断输出
 233:Core/Src/main.c ****  */
 234:Core/Src/main.c **** 
 235:Core/Src/main.c **** static void SpeedLoop_Fake(void)
 236:Core/Src/main.c **** {
 237:Core/Src/main.c ****   fakeUseCurrent = fakeUseSpeed - RxSpeed;
 238:Core/Src/main.c **** 
 239:Core/Src/main.c ****   if (fakeUseCurrent > 2000) 
 240:Core/Src/main.c ****   {
 241:Core/Src/main.c ****     fakeUseCurrent = 2000;
 242:Core/Src/main.c ****   }
 243:Core/Src/main.c ****   if (fakeUseCurrent < -2000)
 244:Core/Src/main.c ****   {
 245:Core/Src/main.c ****     fakeUseCurrent = -2000;
 246:Core/Src/main.c ****   }
 247:Core/Src/main.c ****   CAN_cmd_chassis(fakeUseCurrent, 0, 0, 0);
 248:Core/Src/main.c **** }
