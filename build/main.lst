 328:Core/Src/main.c **** /*
 329:Core/Src/main.c ****  * 接收回调：CAN1 FIFO0 收到匹配帧时由 HAL 自动调用（运行在中断里）
 330:Core/Src/main.c ****  * 功能：把 8 字节原始数据搬到全局变量，供调试窗口查看
 331:Core/Src/main.c ****  */
 332:Core/Src/main.c **** void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan1)
 333:Core/Src/main.c **** {
 334:Core/Src/main.c ****   CAN_RxHeaderTypeDef RxHeader;
 335:Core/Src/main.c ****   uint8_t tmp[8];
 336:Core/Src/main.c **** 
 337:Core/Src/main.c ****   /* HAL函数：从 FIFO0 取出 1 帧数据
 338:Core/Src/main.c ****      帧头信息写入 RxHeader（ID、长度等），8 字节数据写入 tmp，成功返回 HAL_
 339:Core/Src/main.c ****   if (HAL_CAN_GetRxMessage(hcan1, CAN_RX_FIFO0, &RxHeader, tmp) == HAL_OK)
 340:Core/Src/main.c ****   {
 341:Core/Src/main.c ****     /* ① 刷新"还活着"的时间戳：速度环用它判断反馈有没有断线 */
 342:Core/Src/main.c ****     /* HAL函数：读取系统已运行的毫秒数（由 SysTick 中断每 1ms 累加一次）
 343:Core/Src/main.c ****        这里用于速度环的"反馈超时"判断 */
 344:Core/Src/main.c ****     RxLastTick = HAL_GetTick();
 345:Core/Src/main.c **** 
