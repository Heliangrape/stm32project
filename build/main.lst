 408:Core/Src/main.c ****       RxEcd4[idx]     = (uint16_t)((tmp[0] << 8) | tmp[1]);  // 编码器角度 0~8191
 409:Core/Src/main.c ****       RxSpeed4[idx]   = (int16_t) ((tmp[2] << 8) | tmp[3]);  // 转速 RPM
