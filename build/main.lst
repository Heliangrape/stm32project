 282:Core/Src/main.c **** /*
 283:Core/Src/main.c ****  * 速度环（内环）：让电机稳定在 SPD_TARGET 转速
 284:Core/Src/main.c ****  * 输出 = PI(目标转速 - 实际转速) → 电流
 285:Core/Src/main.c ****  * 两道保护：① 反馈超时（50ms 收不到新帧）→ 断输出
 286:Core/Src/main.c ****  *           ② 转速超过 SPD_MAX            → 断输出
 287:Core/Src/main.c ****  */
 288:Core/Src/main.c **** 
 289:Core/Src/main.c **** static void SpeedLoop_Fake(void)
 290:Core/Src/main.c **** {
 291:Core/Src/main.c ****   /* 目标转速 = 前后项(fakeUseSpeed) + 左右项(fakeUseSpeedLR)，各自带自己的方向�
 292:Core/Src/main.c ****      麦轮横移时左右两侧轮子的世界转向相反 → 本体系数 = 前后系数 × 横�
 293:Core/Src/main.c ****   /* 每行开头的方向系数：+1 = 与 1 号电机同向；-1 = 镜像安装（本体必须反
 294:Core/Src/main.c ****      —— 哪个电机转反了，就改那一行的符号
 295:Core/Src/main.c ****      注意：RxSpeed4[i] 是"电机本体"的转速，不乘方向系数 */
 296:Core/Src/main.c ****   fakeUseCurrent1 = (-1) * fakeUseSpeed + (-1) * fakeUseSpeedLR + (1) * fakeUseOmega - RxSpeed4[0];
 297:Core/Src/main.c ****   fakeUseCurrent2 = ( 1) * fakeUseSpeed + (-1) * fakeUseSpeedLR + (1) * fakeUseOmega - RxSpeed4[1];
 298:Core/Src/main.c ****   fakeUseCurrent3 = ( 1) * fakeUseSpeed + ( 1) * fakeUseSpeedLR + (1) * fakeUseOmega - RxSpeed4[2];
 299:Core/Src/main.c ****   fakeUseCurrent4 = (-1) * fakeUseSpeed + ( 1) * fakeUseSpeedLR + (1) * fakeUseOmega - RxSpeed4[3];
 300:Core/Src/main.c **** 
 301:Core/Src/main.c ****   if (fakeUseCurrent1 > 2000) 
 302:Core/Src/main.c ****   {
 303:Core/Src/main.c ****     fakeUseCurrent1 = 2000;
 304:Core/Src/main.c ****   }
 305:Core/Src/main.c ****   if (fakeUseCurrent1 < -2000)
 306:Core/Src/main.c ****   {
 307:Core/Src/main.c ****     fakeUseCurrent1 = -2000;
 308:Core/Src/main.c ****   }
 309:Core/Src/main.c ****   /* 2/3/4 号电机同样的限幅 */
 310:Core/Src/main.c ****   if (fakeUseCurrent2 >  2000) fakeUseCurrent2 =  2000;
 311:Core/Src/main.c ****   if (fakeUseCurrent2 < -2000) fakeUseCurrent2 = -2000;
 312:Core/Src/main.c ****   if (fakeUseCurrent3 >  2000) fakeUseCurrent3 =  2000;
 313:Core/Src/main.c ****   if (fakeUseCurrent3 < -2000) fakeUseCurrent3 = -2000;
 314:Core/Src/main.c ****   if (fakeUseCurrent4 >  2000) fakeUseCurrent4 =  2000;
 315:Core/Src/main.c ****   if (fakeUseCurrent4 < -2000) fakeUseCurrent4 = -2000;
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc3zNuvX.s 			page 7


 316:Core/Src/main.c **** 
 317:Core/Src/main.c ****   CAN_cmd_chassis(fakeUseCurrent1, fakeUseCurrent2, fakeUseCurrent3, fakeUseCurrent4);
 318:Core/Src/main.c **** }
