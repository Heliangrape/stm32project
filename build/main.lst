 472:Core/Src/main.c **** /*
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc3zNuvX.s 			page 13


 473:Core/Src/main.c ****  * 遥控器在线判断
 474:Core/Src/main.c ****  * 返回 1 = 掉线（超过 RC_TIMEOUT_MS 毫秒没收到任何一帧）
 475:Core/Src/main.c ****  * 用途：掉线时必须让电机停住，否则机器人会带着最后一条指令一直跑
 476:Core/Src/main.c ****  */
 477:Core/Src/main.c **** uint8_t RC_is_offline(void)
 478:Core/Src/main.c **** {
 479:Core/Src/main.c ****   if (rc_last_tick == 0)     /* 上电后一帧都没收到过 */
 480:Core/Src/main.c ****   {
 481:Core/Src/main.c ****     return 1;
 482:Core/Src/main.c ****   }
 483:Core/Src/main.c ****   return (HAL_GetTick() - rc_last_tick > RC_TIMEOUT_MS) ? 1 : 0;
 484:Core/Src/main.c **** }
 485:Core/Src/main.c **** 
 486:Core/Src/main.c **** /*
 487:Core/Src/main.c ****  * DMA 版 printf：把格式化好的字符串用 USART1 的 DMA 发到电脑串口助手
 488:Core/Src/main.c ****  * 与标准 printf 的区别：DMA 在后台搬数据，CPU 只做"格式化"这一步
 489:Core/Src/main.c ****  */
 490:Core/Src/main.c **** void usart_printf(const char *fmt, ...)
 491:Core/Src/main.c **** {
 492:Core/Src/main.c ****   static uint8_t tx_buf[PRINT_BUF_SIZE];   /* static：DMA 在后台读它，不能放栈上 */
 493:Core/Src/main.c ****   va_list ap;
 494:Core/Src/main.c ****   int len;
 495:Core/Src/main.c ****   uint32_t t0;
 496:Core/Src/main.c **** 
 497:Core/Src/main.c ****   /*
 498:Core/Src/main.c ****    * 先等上一次 DMA 发完，再往 tx_buf 写新内容
 499:Core/Src/main.c ****    * 不等的话会把"正在发送中的缓冲"覆盖掉 → 输出乱码
 500:Core/Src/main.c ****    * 加超时保护：串口万一异常也不会在这儿死等
 501:Core/Src/main.c ****    */
 502:Core/Src/main.c ****   t0 = HAL_GetTick();
 503:Core/Src/main.c ****   while (huart1.gState != HAL_UART_STATE_READY)
 504:Core/Src/main.c ****   {
 505:Core/Src/main.c ****     if (HAL_GetTick() - t0 > 10)
 506:Core/Src/main.c ****     {
 507:Core/Src/main.c ****       return;
 508:Core/Src/main.c ****     }
 509:Core/Src/main.c ****   }
 510:Core/Src/main.c **** 
 511:Core/Src/main.c ****   /* 变参三步走：va_start 取参数 → vsnprintf 格式化 → va_end 收尾 */
 512:Core/Src/main.c ****   va_start(ap, fmt);
 513:Core/Src/main.c ****   len = vsnprintf((char *)tx_buf, PRINT_BUF_SIZE, fmt, ap);
 514:Core/Src/main.c ****   va_end(ap);
 515:Core/Src/main.c **** 
 516:Core/Src/main.c ****   if (len <= 0)
 517:Core/Src/main.c ****   {
 518:Core/Src/main.c ****     return;
 519:Core/Src/main.c ****   }
 520:Core/Src/main.c ****   if (len > PRINT_BUF_SIZE - 1)
 521:Core/Src/main.c ****   {
 522:Core/Src/main.c ****     len = PRINT_BUF_SIZE - 1;      /* 内容超出缓冲时截断，防止越界发送 */
 523:Core/Src/main.c ****   }
 524:Core/Src/main.c **** 
 525:Core/Src/main.c ****   /* HAL函数：启动 DMA 发送（非阻塞，立刻返回，数据由 DMA 后台搬走） */
 526:Core/Src/main.c ****   HAL_UART_Transmit_DMA(&huart1, tx_buf, (uint16_t)len);
 527:Core/Src/main.c **** }
 528:Core/Src/main.c **** 
 529:Core/Src/main.c **** /*
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc3zNuvX.s 			page 14


 530:Core/Src/main.c ****  * 遥控器接收完成回调（HAL 的弱函数，这里重写它）
 531:Core/Src/main.c ****  * HAL 已经替我们做完：开 IDLE 中断、进 USART3_IRQHandler、算出收到多少字节�
 532:Core/Src/main.c ****  * 关 DMA、重启 DMA —— 我们只拿到"这一趟收了多少字节(Size)"这一个结果
 533:Core/Src/main.c ****  */
 534:Core/Src/main.c **** void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
 535:Core/Src/main.c **** {
 536:Core/Src/main.c ****   if (huart->Instance != USART3)
 537:Core/Src/main.c ****   {
 538:Core/Src/main.c ****     return;
 539:Core/Src/main.c ****   }
 540:Core/Src/main.c **** 
 541:Core/Src/main.c ****   /* 半传输事件：缓冲区只收到一半，不是"一帧结束"，忽略 */
 542:Core/Src/main.c ****   if (huart->RxEventType == HAL_UART_RXEVENT_HT)
 543:Core/Src/main.c ****   {
 544:Core/Src/main.c ****     return;
 545:Core/Src/main.c ****   }
 546:Core/Src/main.c **** 
 547:Core/Src/main.c ****   /* 必须正好是完整一帧（18 字节）才解码；长度不对说明是噪声或中间丢�
 548:Core/Src/main.c ****   if (Size == RC_FRAME_LENGTH)
 549:Core/Src/main.c ****   {
 550:Core/Src/main.c ****     sbus_to_rc(rc_buf, &rc_ctrl);      /* 生数据 → 物理量 */
 551:Core/Src/main.c ****     rc_last_tick = HAL_GetTick();      /* 刷新"遥控器还活着"的时间戳 */
 552:Core/Src/main.c ****   }
 553:Core/Src/main.c **** 
 554:Core/Src/main.c ****   /* 重新武装：再挂一次 DMA 接收，等下一帧（漏了这句就只能收到一帧） *
 555:Core/Src/main.c ****   HAL_UARTEx_ReceiveToIdle_DMA(&huart3, rc_buf, RC_FRAME_LENGTH);
 556:Core/Src/main.c **** 
 557:Core/Src/main.c ****   /* 关掉"半传输中断"：让 HAL 只在"空闲/缓冲区满"时才回调，少进几次中断
 558:Core/Src/main.c ****   __HAL_DMA_DISABLE_IT(huart->hdmarx, DMA_IT_HT);
 559:Core/Src/main.c **** }
 560:Core/Src/main.c **** 
 561:Core/Src/main.c **** /*
 562:Core/Src/main.c ****  * UART 错误回调：HAL 遇到校验错/帧错/溢出时会进这里，
 563:Core/Src/main.c ****  * 而且它**已经自动停止了接收**（UART_EndRxTransfer）—— 所以我们的任务就�
 564:Core/Src/main.c ****  * 清标志 + 把 DMA 接收重新挂上；不做的话，遇到一次错误就永久收不到数�
 565:Core/Src/main.c ****  */
 566:Core/Src/main.c **** void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
 567:Core/Src/main.c **** {
 568:Core/Src/main.c ****   if (huart->Instance != USART3)
 569:Core/Src/main.c ****   {
 570:Core/Src/main.c ****     return;
 571:Core/Src/main.c ****   }
 572:Core/Src/main.c **** 
 573:Core/Src/main.c ****   __HAL_UART_CLEAR_OREFLAG(huart);          /* 读 SR + DR，清掉错误标志 */
 574:Core/Src/main.c ****   huart->ErrorCode = HAL_UART_ERROR_NONE;   /* 手动清错误码 */
 575:Core/Src/main.c **** 
 576:Core/Src/main.c ****   HAL_UARTEx_ReceiveToIdle_DMA(&huart3, rc_buf, RC_FRAME_LENGTH);   /* 重新武装 */
 577:Core/Src/main.c ****   __HAL_DMA_DISABLE_IT(huart->hdmarx, DMA_IT_HT);
 578:Core/Src/main.c **** }
 579:Core/Src/main.c **** 
 580:Core/Src/main.c **** /* ==========================================================================
 581:Core/Src/main.c ****  * BMI088 陀螺仪驱动（最小版：只读角速度，不做姿态融合）
 582:Core/Src/main.c ****  * 接线：SPI1 = PB3(SCK) / PB4(MISO) / PA7(MOSI)
 583:Core/Src/main.c ****  *       CS   = PA4(加速度计 CS1_ACCEL) / PB0(陀螺仪 CS1_GYRO)，都是低电平选中
 584:Core/Src/main.c ****  * 寄存器：0x00 = ID（陀螺仪应读 0x0F）
 585:Core/Src/main.c ****  *         0x02~0x07 = X/Y/Z 三轴角速度，每轴 16 位（低字节在前）
 586:Core/Src/main.c ****  * ========================================================================== */
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc3zNuvX.s 			page 15


 587:Core/Src/main.c **** 
 588:Core/Src/main.c **** #define ACC_CS_L()   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET)
 589:Core/Src/main.c **** #define ACC_CS_H()   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET)
 590:Core/Src/main.c **** #define GYRO_CS_L()  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET)
 591:Core/Src/main.c **** #define GYRO_CS_H()  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET)
 592:Core/Src/main.c **** 
 593:Core/Src/main.c **** /*
 594:Core/Src/main.c ****  * SPI 全双工收发 1 字节：发出去的同时就在收（SPI 的物理特性决定的）
 595:Core/Src/main.c ****  * BMI088 用 SPI 模式 3（CPOL=1, CPHA=1），和 MX_SPI1_Init 里的配置一致
 596:Core/Src/main.c ****  */
 597:Core/Src/main.c **** static uint8_t BMI088_rw(uint8_t tx)
 598:Core/Src/main.c **** {
 599:Core/Src/main.c ****   uint8_t rx = 0;
 600:Core/Src/main.c ****   /* HAL函数：SPI 全双工收发
 601:Core/Src/main.c ****      参数：SPI句柄、发送缓冲、接收缓冲、字节数、超时(ms) */
 602:Core/Src/main.c ****   HAL_SPI_TransmitReceive(&hspi1, &tx, &rx, 1, 100);
 603:Core/Src/main.c ****   return rx;
 604:Core/Src/main.c **** }
 605:Core/Src/main.c **** 
 606:Core/Src/main.c **** /*
 607:Core/Src/main.c ****  * 读陀螺仪的连续 len 个寄存器
 608:Core/Src/main.c ****  * BMI088 的 SPI 协议规定：读操作的地址最高位要置 1，写操作清 0
 609:Core/Src/main.c ****  * 整个过程 CS 必须一直保持低电平，读完才拉高（拉高 = 一帧结束）
 610:Core/Src/main.c ****  */
 611:Core/Src/main.c **** static void BMI088_gyro_read_regs(uint8_t reg, uint8_t *buf, uint8_t len)
 612:Core/Src/main.c **** {
 613:Core/Src/main.c ****   uint8_t i;
 614:Core/Src/main.c ****   reg |= 0x80;                  /* 最高位 = 1 → 读操作 */
 615:Core/Src/main.c ****   GYRO_CS_L();
 616:Core/Src/main.c ****   BMI088_rw(reg);               /* 先发寄存器地址 */
 617:Core/Src/main.c ****   for (i = 0; i < len; i++)
 618:Core/Src/main.c ****   {
 619:Core/Src/main.c ****     buf[i] = BMI088_rw(0x00);   /* 之后每发一个空字节，就收回一个数据字节 */
 620:Core/Src/main.c ****   }
 621:Core/Src/main.c ****   GYRO_CS_H();
 622:Core/Src/main.c **** }
 623:Core/Src/main.c **** 
 624:Core/Src/main.c **** /*
 625:Core/Src/main.c ****  * 读三轴角速度 → rad/s
 626:Core/Src/main.c ****  * 寄存器 0x02~0x07 依次是 X_L, X_M, Y_L, Y_M, Z_L, Z_M（低字节在前）
 627:Core/Src/main.c ****  * 注意：教材 P182 的文字写成"RATE_Z_MSB 到 RATE_X_LSB"是写反的，
 628:Core/Src/main.c ****  *       以 P183 的代码为准（X 在前），这里和 P183 保持一致
 629:Core/Src/main.c ****  */
 630:Core/Src/main.c **** static void BMI088_read_gyro(float g[3])
 631:Core/Src/main.c **** {
 632:Core/Src/main.c ****   uint8_t buf[6];
 633:Core/Src/main.c ****   BMI088_gyro_read_regs(0x02, buf, 6);
 634:Core/Src/main.c ****   g[0] = (float)(int16_t)((buf[1] << 8) | buf[0]) * BMI088_GYRO_SEN;   /* X 轴 */
 635:Core/Src/main.c ****   g[1] = (float)(int16_t)((buf[3] << 8) | buf[2]) * BMI088_GYRO_SEN;   /* Y 轴 */
 636:Core/Src/main.c ****   g[2] = (float)(int16_t)((buf[5] << 8) | buf[4]) * BMI088_GYRO_SEN;   /* Z 轴 */
 637:Core/Src/main.c **** }
 638:Core/Src/main.c **** 
 639:Core/Src/main.c **** /*
 640:Core/Src/main.c ****  * 读陀螺仪 ID（寄存器 0x00），正常返回 0x0F
 641:Core/Src/main.c ****  * 作用：上电自检 —— 读不到 0x0F 说明 SPI 接线/片选/模式有问题，不用瞎
 642:Core/Src/main.c ****  */
 643:Core/Src/main.c **** static uint8_t BMI088_read_gyro_id(void)
