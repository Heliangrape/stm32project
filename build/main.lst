 145:Core/Src/main.c **** /*
 146:Core/Src/main.c ****  * CAN1 初始化，整个程序只调用一次
 147:Core/Src/main.c ****  * 波特率 = APB1 / (Prescaler x (1 + TimeSeg1 + TimeSeg2))
 148:Core/Src/main.c ****  *        = 42MHz / (3 x (1 + 11 + 2)) = 42MHz / 42 = 1Mbps
 149:Core/Src/main.c ****  * 注意：APB1 频率由时钟配置决定，换了晶振/时钟树后这里必须重新算
 150:Core/Src/main.c ****  */
 151:Core/Src/main.c **** static void CAN1_Init(void)
 152:Core/Src/main.c **** {
 153:Core/Src/main.c ****   GPIO_InitTypeDef gpio = {0};
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****   /* HAL宏：使能 CAN1 外设的时钟。STM32 外设默认断电，不开时钟则 CAN1 完全�
 156:Core/Src/main.c ****   __HAL_RCC_CAN1_CLK_ENABLE();                 // 开 CAN1 时钟
 157:Core/Src/main.c ****   /* HAL宏：使能 GPIOD 的时钟。PD0/PD1 属于 D 口，不开时钟就配置不了这两个�
 158:Core/Src/main.c ****   __HAL_RCC_GPIOD_CLK_ENABLE();                // 开 GPIOD 时钟（PD0/PD1 在 D 口）
 159:Core/Src/main.c **** 
 160:Core/Src/main.c ****   gpio.Pin       = GPIO_PIN_0 | GPIO_PIN_1;    // PD0=RX, PD1=TX
 161:Core/Src/main.c ****   gpio.Mode      = GPIO_MODE_AF_PP;            // 复用推挽
 162:Core/Src/main.c ****   gpio.Pull      = GPIO_PULLUP;                // 上拉
 163:Core/Src/main.c ****   gpio.Speed     = GPIO_SPEED_FREQ_VERY_HIGH;  // 高速
 164:Core/Src/main.c ****   gpio.Alternate = GPIO_AF9_CAN1;              // 复用功能 = CAN1 (AF9)
 165:Core/Src/main.c ****   /* HAL函数：按 gpio 结构体里的配置初始化 GPIO
 166:Core/Src/main.c ****      作用：把 PD0/PD1 从"普通IO"切换成"CAN1 复用功能"（AF9） */
 167:Core/Src/main.c ****   HAL_GPIO_Init(GPIOD, &gpio);
 168:Core/Src/main.c **** 
 169:Core/Src/main.c ****   hcan1.Instance           = CAN1;             // CAN1 外设
 170:Core/Src/main.c ****   hcan1.Init.Prescaler     = 3;                // 分频（APB1=42MHz，3x14=42 → 正好 1Mbps）
 171:Core/Src/main.c ****   hcan1.Init.Mode          = CAN_MODE_NORMAL;  // 正常模式
 172:Core/Src/main.c ****   hcan1.Init.SyncJumpWidth = CAN_SJW_1TQ;      // 同步跳转宽度
 173:Core/Src/main.c ****   hcan1.Init.TimeSeg1      = CAN_BS1_11TQ;     // 段1
 174:Core/Src/main.c ****   hcan1.Init.TimeSeg2      = CAN_BS2_2TQ;      // 段2（1+11+2=14 → 3x14=42 → 1Mbps，采样�
 175:Core/Src/main.c ****   hcan1.Init.TimeTriggeredMode    = DISABLE;
 176:Core/Src/main.c ****   hcan1.Init.AutoBusOff           = ENABLE;
 177:Core/Src/main.c ****   hcan1.Init.AutoWakeUp           = DISABLE;
 178:Core/Src/main.c ****   hcan1.Init.AutoRetransmission   = ENABLE;
 179:Core/Src/main.c ****   hcan1.Init.ReceiveFifoLocked    = DISABLE;
 180:Core/Src/main.c ****   hcan1.Init.TransmitFifoPriority = DISABLE;
 181:Core/Src/main.c ****   /* HAL函数：用 hcan1.Init 里的参数初始化 CAN1 控制器
 182:Core/Src/main.c ****      内部动作：算波特率、把分频/时间段/工作模式写进 CAN 寄存器 */
 183:Core/Src/main.c ****   HAL_CAN_Init(&hcan1);
 184:Core/Src/main.c **** 
 185:Core/Src/main.c ****   /*
 186:Core/Src/main.c ****    * 过滤器（ID_LIST 列表模式）：只放行 0x201~0x204 四个电调反馈帧
 187:Core/Src/main.c ****    * 注意：16 位列表模式下这 4 个字段都是"ID 存储位"，标准 ID 需左移 5 位
 188:Core/Src/main.c ****    */
 189:Core/Src/main.c ****   CAN_FilterTypeDef filter = {0};
 190:Core/Src/main.c ****   filter.FilterMode           = CAN_FILTERMODE_IDLIST;   // 列表模式：只收列出的 ID
 191:Core/Src/main.c ****   filter.FilterScale          = CAN_FILTERSCALE_16BIT;   // 16 位 → 一组装 4 个 ID
 192:Core/Src/main.c ****   filter.FilterIdHigh         = 0x201 << 5;              // 1号电机
 193:Core/Src/main.c ****   filter.FilterIdLow          = 0x202 << 5;              // 2号电机
 194:Core/Src/main.c ****   filter.FilterMaskIdHigh     = 0x203 << 5;              // 3号电机
 195:Core/Src/main.c ****   filter.FilterMaskIdLow      = 0x204 << 5;              // 4号电机
 196:Core/Src/main.c ****   filter.FilterBank           = 0;                       // CAN1 只能用 0~13
 197:Core/Src/main.c ****   filter.FilterFIFOAssignment = CAN_FILTER_FIFO0;        // 送进 FIFO0
 198:Core/Src/main.c ****   filter.FilterActivation     = ENABLE;
 199:Core/Src/main.c ****   /* HAL函数：把上面的 filter 配置写进硬件过滤器
 200:Core/Src/main.c ****      作用：决定总线上哪些 ID 的帧能被收进来（不匹配的硬件直接丢弃） */
 201:Core/Src/main.c ****   HAL_CAN_ConfigFilter(&hcan1, &filter);
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cc1rSlMD.s 			page 5


 202:Core/Src/main.c **** 
 203:Core/Src/main.c ****   /* HAL函数：让 CAN 离开"初始化模式"、进入正常工作状态
 204:Core/Src/main.c ****      不调用的话，后面所有发送/接收都会直接失败 */
 205:Core/Src/main.c ****   HAL_CAN_Start(&hcan1);                       // 启动 CAN（不启动发送会失败）
 206:Core/Src/main.c **** 
 207:Core/Src/main.c ****   /* 打开接收中断：FIFO0 收到匹配帧 → 触发 CAN1_RX0 中断 → 调用回调 */
 208:Core/Src/main.c ****   /* HAL函数：打开"FIFO0 收到新消息"这个中断使能
 209:Core/Src/main.c ****      打开后：FIFO0 一有新帧，HAL 就会自动调用接收回调函数 */
 210:Core/Src/main.c ****   HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);
 211:Core/Src/main.c ****   /* HAL函数：设置 CAN1_RX0 中断的优先级（抢占优先级0、子优先级0）
 212:Core/Src/main.c ****      数值越小优先级越高，0 是最高优先级 */
 213:Core/Src/main.c ****   HAL_NVIC_SetPriority(CAN1_RX0_IRQn, 0, 0);   // 优先级
 214:Core/Src/main.c ****   /* HAL函数：在 NVIC（中断控制器）里真正"放行"这个中断
 215:Core/Src/main.c ****      不调用的话，即使 FIFO 有数据，CPU 也不会跳进中断函数 */
 216:Core/Src/main.c ****   HAL_NVIC_EnableIRQ(CAN1_RX0_IRQn);           // 放行中断
 217:Core/Src/main.c **** }
 218:Core/Src/main.c **** 
 219:Core/Src/main.c **** /*
 220:Core/Src/main.c ****  * 发送电流指令给 1~4 号电调（CAN ID = 0x200）
 221:Core/Src/main.c ****  * cur1~cur4：电流给定，正=正转，负=反转，±16384 对应 ±20A
 222:Core/Src/main.c ****  */
 223:Core/Src/main.c **** static void CAN_cmd_chassis(int16_t cur1, int16_t cur2, int16_t cur3, int16_t cur4)
 224:Core/Src/main.c **** {
 225:Core/Src/main.c ****   uint32_t TxMailbox;
 226:Core/Src/main.c **** 
 227:Core/Src/main.c ****   TxHeader.StdId = 0x200;         // CAN ID
 228:Core/Src/main.c ****   TxHeader.IDE   = CAN_ID_STD;    // 标准帧
 229:Core/Src/main.c ****   TxHeader.RTR   = CAN_RTR_DATA;  // 数据帧
 230:Core/Src/main.c ****   TxHeader.DLC   = 8;             // 8 字节
 231:Core/Src/main.c **** 
 232:Core/Src/main.c ****   TxData[0] = cur1 >> 8;   TxData[1] = cur1 & 0xFF;   // 电机1
 233:Core/Src/main.c ****   TxData[2] = cur2 >> 8;   TxData[3] = cur2 & 0xFF;   // 电机2
 234:Core/Src/main.c ****   TxData[4] = cur3 >> 8;   TxData[5] = cur3 & 0xFF;   // 电机3
 235:Core/Src/main.c ****   TxData[6] = cur4 >> 8;   TxData[7] = cur4 & 0xFF;   // 电机4
 236:Core/Src/main.c **** 
 237:Core/Src/main.c ****   /* HAL函数：把这一帧放进发送邮箱并请求发送
 238:Core/Src/main.c ****      参数依次：CAN句柄、帧头（含ID/长度）、8字节数据、回填"用了哪个邮�
 239:Core/Src/main.c ****      注意：返回 HAL_OK 只表示"投递成功"，不代表电调收到了（要等对方回 AC
 240:Core/Src/main.c ****   HAL_CAN_AddTxMessage(&hcan1, &TxHeader, TxData, &TxMailbox);
 241:Core/Src/main.c **** }
 242:Core/Src/main.c **** 
 243:Core/Src/main.c **** /*
 244:Core/Src/main.c ****  * 速度环（内环）：让电机稳定在 SPD_TARGET 转速
 245:Core/Src/main.c ****  * 输出 = PI(目标转速 - 实际转速) → 电流
 246:Core/Src/main.c ****  * 两道保护：① 反馈超时（50ms 收不到新帧）→ 断输出
 247:Core/Src/main.c ****  *           ② 转速超过 SPD_MAX            → 断输出
 248:Core/Src/main.c ****  */
 249:Core/Src/main.c **** 
 250:Core/Src/main.c **** static void SpeedLoop_Fake(void)
 251:Core/Src/main.c **** {
 252:Core/Src/main.c ****   /* 目标转速 = 前后项(fakeUseSpeed) + 左右项(fakeUseSpeedLR)，各自带自己的方向�
