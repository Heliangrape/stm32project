 398:Core/Src/main.c ****                   绿灯稳定闪烁 = 接收正常 ✅
 399:Core/Src/main.c ****                   绿灯不动     = 接收断了 ❌                        */
 400:Core/Src/main.c ****       if ((RxCount % 2000) == 1)   // 4 个电机共约 4kHz 帧率 → 2000 帧仍约 2Hz
 401:Core/Src/main.c ****       {
 402:Core/Src/main.c ****         /* HAL函数：翻转引脚电平（当前是高就变低，是低就变高） */
