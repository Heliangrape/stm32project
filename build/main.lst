 683:Core/Src/main.c ****   /* ★ CAN1 必须最先初始化！
 684:Core/Src/main.c ****      原因：CubeMX 生成的 MX_CAN1_Init() 已经用 875kbps 把 CAN 拉到总线上了，
 685:Core/Src/main.c ****      如果在这里先做 BMI088 的 1.3 秒零漂标定，CAN 就会在错误波特率下污染 1
 686:Core/Src/main.c ****      总线 1.3 秒 → 4 个 C620 电调全部出错掉线（现象：RxCount=0、电机不动）�
 687:Core/Src/main.c ****      所以 CAN1_Init() 必须紧跟在外设初始化之后、任何耗时操作之前调用。 */
 688:Core/Src/main.c ****   CAN1_Init();                      /* CAN1 初始化：整个程序只做一次 */
 689:Core/Src/main.c **** 
 690:Core/Src/main.c ****   /* ---- BMI088 片选上电先拉高 ----
 691:Core/Src/main.c ****      CubeMX 把 PA4/PB0 的初始电平配成了低电平，而 CS 是低电平选中，
 692:Core/Src/main.c ****      不修的话上电瞬间加速度计和陀螺仪会同时被选中，两个芯片一起抢 MIS
 693:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);   /* 加速度计 CS 拉高 */
 694:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);   /* 陀螺仪   CS 拉高 */
 695:Core/Src/main.c **** 
 696:Core/Src/main.c ****   /* ---- BMI088 上电自检：读陀螺仪 ID，正常应该是 0x0F ---- */
 697:Core/Src/main.c ****   BMI088_gyro_id = BMI088_read_gyro_id();
 698:Core/Src/main.c ****   usart_printf("[BMI088] gyro_id = 0x%02X (expect 0x0F)\r\n", BMI088_gyro_id);
 699:Core/Src/main.c **** 
 700:Core/Src/main.c ****   /* ---- 零漂标定：连续采 1000 次求平均（约 1.3 秒）
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//cczYei40.s 			page 17


 701:Core/Src/main.c ****      陀螺仪静止时也会输出几十 LSB 的零偏，不减掉的话积分出的角度会一�
 702:Core/Src/main.c ****      ★ 这段时间小车必须静止不动！ */
 703:Core/Src/main.c ****   {
 704:Core/Src/main.c ****     float sum[3] = {0.0f, 0.0f, 0.0f};
 705:Core/Src/main.c ****     float g[3];
 706:Core/Src/main.c ****     int i;
 707:Core/Src/main.c ****     for (i = 0; i < 1000; i++)
 708:Core/Src/main.c ****     {
 709:Core/Src/main.c ****       BMI088_read_gyro(g);
 710:Core/Src/main.c ****       sum[0] += g[0];
 711:Core/Src/main.c ****       sum[1] += g[1];
 712:Core/Src/main.c ****       sum[2] += g[2];
 713:Core/Src/main.c ****       HAL_Delay(1);
 714:Core/Src/main.c ****     }
 715:Core/Src/main.c ****     gyro_offset[0] = sum[0] / 1000.0f;
 716:Core/Src/main.c ****     gyro_offset[1] = sum[1] / 1000.0f;
 717:Core/Src/main.c ****     gyro_offset[2] = sum[2] / 1000.0f;
 718:Core/Src/main.c ****   }
 719:Core/Src/main.c ****   /* 用整数打印（放大 10 万倍），因为 usart_printf 没开浮点打印支持 */
 720:Core/Src/main.c ****   usart_printf("[BMI088] offset(1e5) = %d %d %d rad/s\r\n",
 721:Core/Src/main.c ****                (int)(gyro_offset[0] * 100000.0f),
 722:Core/Src/main.c ****                (int)(gyro_offset[1] * 100000.0f),
 723:Core/Src/main.c ****                (int)(gyro_offset[2] * 100000.0f));
 724:Core/Src/main.c **** 
 725:Core/Src/main.c ****   /* HAL函数：启动 USART3 的"DMA + 空闲中断"接收
