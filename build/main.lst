 703:Core/Src/main.c **** 
 704:Core/Src/main.c ****   /* ---- 零漂标定：连续采 1000 次求平均（约 1.3 秒）
 705:Core/Src/main.c ****      陀螺仪静止时也会输出几十 LSB 的零偏，不减掉的话积分出的角度会一�
 706:Core/Src/main.c ****      ★ 这段时间小车必须静止不动！ */
 707:Core/Src/main.c ****   {
 708:Core/Src/main.c ****     float sum[3] = {0.0f, 0.0f, 0.0f};
 709:Core/Src/main.c ****     float g[3];
 710:Core/Src/main.c ****     int i;
 711:Core/Src/main.c ****     for (i = 0; i < 1000; i++)
 712:Core/Src/main.c ****     {
 713:Core/Src/main.c ****       BMI088_read_gyro(g);
 714:Core/Src/main.c ****       sum[0] += g[0];
 715:Core/Src/main.c ****       sum[1] += g[1];
 716:Core/Src/main.c ****       sum[2] += g[2];
 717:Core/Src/main.c ****       HAL_Delay(1);
 718:Core/Src/main.c ****     }
 719:Core/Src/main.c ****     gyro_offset[0] = sum[0] / 1000.0f;
 720:Core/Src/main.c ****     gyro_offset[1] = sum[1] / 1000.0f;
 721:Core/Src/main.c ****     gyro_offset[2] = sum[2] / 1000.0f;
 722:Core/Src/main.c ****   }
 723:Core/Src/main.c ****   /* 用整数打印（放大 10 万倍），因为 usart_printf 没开浮点打印支持 */
