 770:Core/Src/main.c ****       fakeUseSpeedLR = (int16_t)(-vx * s + vy * c);
 771:Core/Src/main.c ****     }
 772:Core/Src/main.c ****     fakeUseOmega = rc_ctrl.rc.ch[2] * 3;    /* 自转照旧：本来就该是车体系，不参与�
