 259:Core/Src/main.c **** static int32_t  totalCnt = 0;   /* 多圈累计角度（转子计数） */
 260:Core/Src/main.c **** static int32_t  startCnt = 0;   /* 起点：第一次调用时的累计角度 */
 261:Core/Src/main.c **** static uint8_t  started  = 0;   /* 是否已记起点 */
 262:Core/Src/main.c **** 
 263:Core/Src/main.c **** static void Rotate_Fake(int32_t targetAngle){
 264:Core/Src/main.c ****   
 265:Core/Src/main.c ****   
 266:Core/Src/main.c **** 
 267:Core/Src/main.c ****   /* ① 单圈角度 0~8191 累加成"多圈位移"
 268:Core/Src/main.c ****         差值转 int16_t：跨越 0/8191 边界时自动得到 ±小增量，天然处理回绕 */
 269:Core/Src/main.c ****   int32_t dCnt = (int32_t)RxEcd - (int32_t)lastEcd;   /* 本帧增量，范围 -8191 ~ +8191 */
 270:Core/Src/main.c ****   if (dCnt >  4096) dCnt -= 8192;                     /* 正向跨过一圈边界（8191→0） */
 271:Core/Src/main.c ****   if (dCnt < -4096) dCnt += 8192;                     /* 反向跨过一圈边界（0→8191） */
 272:Core/Src/main.c ****   totalCnt += dCnt;
 273:Core/Src/main.c ****   lastEcd   = RxEcd;
 274:Core/Src/main.c **** 
 275:Core/Src/main.c ****   if (!started)                     /* 第一次调用：记下起点 */
 276:Core/Src/main.c ****   {
 277:Core/Src/main.c ****     startCnt = totalCnt;
 278:Core/Src/main.c ****     started  = 1;
 279:Core/Src/main.c ****   }
 280:Core/Src/main.c **** 
 281:Core/Src/main.c ****   /* ② 位置误差（计数）：正 = 还差多少到目标
 282:Core/Src/main.c ****         targetAngle = "从起点还要转多少"（不是转到哪） */
 283:Core/Src/main.c ****   errPos = (startCnt + targetAngle) - totalCnt;
 284:Core/Src/main.c **** 
 285:Core/Src/main.c ****   /* ③ PD：P 项 = 误差右移（÷128）当目标转速；D 项 = 用实测转速当阻尼 */
 286:Core/Src/main.c ****   spdCmd = (errPos >> KP_ANG_SHIFT) - (RxSpeed >> KD_ANG_SHIFT);
 287:Core/Src/main.c **** 
 288:Core/Src/main.c ****   /* ④ 目标转速限幅 */
 289:Core/Src/main.c ****   if (spdCmd > SPD_CMD_LIMIT) spdCmd = SPD_CMD_LIMIT;
 290:Core/Src/main.c ****   if (spdCmd < -SPD_CMD_LIMIT) spdCmd = -SPD_CMD_LIMIT;
 291:Core/Src/main.c **** 
 292:Core/Src/main.c ****   /* ⑤ 交给内层执行（内层把它当成 SPD_TARGET 去追） */
 293:Core/Src/main.c ****   fakeUseSpeed = (int16_t)spdCmd;
 294:Core/Src/main.c ****   SpeedLoop_Fake();
 295:Core/Src/main.c **** }
 296:Core/Src/main.c **** 
 297:Core/Src/main.c **** 
 298:Core/Src/main.c **** /*
 299:Core/Src/main.c ****  * 接收回调：CAN1 FIFO0 收到匹配帧时由 HAL 自动调用（运行在中断里）
 300:Core/Src/main.c ****  * 功能：把 8 字节原始数据搬到全局变量，供调试窗口查看
 301:Core/Src/main.c ****  */
 302:Core/Src/main.c **** void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan1)
 303:Core/Src/main.c **** {
 304:Core/Src/main.c ****   CAN_RxHeaderTypeDef RxHeader;
 305:Core/Src/main.c ****   uint8_t tmp[8];
 306:Core/Src/main.c **** 
 307:Core/Src/main.c ****   /* HAL函数：从 FIFO0 取出 1 帧数据
 308:Core/Src/main.c ****      帧头信息写入 RxHeader（ID、长度等），8 字节数据写入 tmp，成功返回 HAL_
 309:Core/Src/main.c ****   if (HAL_CAN_GetRxMessage(hcan1, CAN_RX_FIFO0, &RxHeader, tmp) == HAL_OK)
 310:Core/Src/main.c ****   {
 311:Core/Src/main.c ****     /* ① 刷新"还活着"的时间戳：速度环用它判断反馈有没有断线 */
 312:Core/Src/main.c ****     /* HAL函数：读取系统已运行的毫秒数（由 SysTick 中断每 1ms 累加一次）
 313:Core/Src/main.c ****        这里用于速度环的"反馈超时"判断 */
 314:Core/Src/main.c ****     RxLastTick = HAL_GetTick();
 315:Core/Src/main.c **** 
ARM GAS  /var/folders/cb/95_27lz12970lmkr4d7n44dm0000gn/T//ccOTaU1A.s 			page 7


 316:Core/Src/main.c ****     /* ② 保存帧 ID 和原始 8 字节（调试器里可以直接看） */
 317:Core/Src/main.c ****     RxStdId = RxHeader.StdId;
 318:Core/Src/main.c ****     if (RxStdId == 0x201)                           
 319:Core/Src/main.c ****       {
 320:Core/Src/main.c ****         for (int i = 0; i < 8; i++) RxData[i] = tmp[i];  // 拷贝 8 字节（原始）
 321:Core/Src/main.c ****         RxCount++;                                       // 帧数 +1
 322:Core/Src/main.c ****       
 323:Core/Src/main.c ****       /* ③ 心跳灯：每收到 500 帧就翻转一次绿灯
 324:Core/Src/main.c ****             电调回传频率是 1kHz → 约 2Hz 闪烁（肉眼明显）
 325:Core/Src/main.c ****             作用：不用调试器也能判断接收死活
 326:Core/Src/main.c ****                   绿灯稳定闪烁 = 接收正常 ✅
 327:Core/Src/main.c ****                   绿灯不动     = 接收断了 ❌                        */
 328:Core/Src/main.c ****       if ((RxCount % 500) == 1)
 329:Core/Src/main.c ****       {
 330:Core/Src/main.c ****         /* HAL函数：翻转引脚电平（当前是高就变低，是低就变高） */
 331:Core/Src/main.c ****         HAL_GPIO_TogglePin(LED_G_GPIO_Port, LED_G_Pin);
 332:Core/Src/main.c ****       }
 333:Core/Src/main.c **** 
 334:Core/Src/main.c ****       /* 按电调反馈帧格式拼出物理量：高八位在前，低八位在后 */
 335:Core/Src/main.c ****       RxEcd     = (uint16_t)((RxData[0] << 8) | RxData[1]);  // 编码器角度 0~8191
 336:Core/Src/main.c ****       RxSpeed   = (int16_t) ((RxData[2] << 8) | RxData[3]);  // 转速 RPM
 337:Core/Src/main.c ****       RxCurrent = (int16_t) ((RxData[4] << 8) | RxData[5]);  // 实际电流
 338:Core/Src/main.c ****       RxTemp    = RxData[6];          
 339:Core/Src/main.c ****       Rotate_Fake(400000);                    
 340:Core/Src/main.c ****     }
 341:Core/Src/main.c ****   }
 342:Core/Src/main.c ****   //aaa
 343:Core/Src/main.c **** }
