 736:Core/Src/main.c ****   while (1)
 737:Core/Src/main.c ****   {
 738:Core/Src/main.c ****          // 速度环：目标 500 RPM，PI 输出电流（带双保护）
 739:Core/Src/main.c ****     /* HAL函数：阻塞式延时 1 毫秒（靠 SysTick 中断计时）
 740:Core/Src/main.c ****        这里的作用：构成固定 1kHz 的控制周期（PID 必须等间隔执行） */
