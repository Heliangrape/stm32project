 373:Core/Src/main.c ****       RxCount4[idx]++;                                       // 该电机累计帧数
 374:Core/Src/main.c **** 
 375:Core/Src/main.c ****       /* 1 号电机的值同步留在老变量里（调试习惯 + Rotate_Fake 在用） */
 376:Core/Src/main.c ****       RxEcd     = RxEcd4[0];
 377:Core/Src/main.c ****       RxSpeed   = RxSpeed4[0];
 378:Core/Src/main.c ****       RxCurrent = RxCurrent4[0];
 379:Core/Src/main.c ****       RxTemp    = RxTemp4[0];          
 380:Core/Src/main.c ****                          
 381:Core/Src/main.c ****     }
