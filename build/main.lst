 727:Core/Src/main.c ****            收满一帧（或总线空闲）时 HAL 自动调用 HAL_UARTEx_RxEventCallback */
 728:Core/Src/main.c ****   __HAL_UART_CLEAR_OREFLAG(&huart3);   /* 先清掉上电瞬间可能残留的错误标志，
